# Copy to .env and fill in. Never commit real keys.
# This bot talks to Arcus MAINNET only.

ARCUS_MARKET=BTC-USD
ARCUS_ACCOUNT_INDEX=0

# Master wallet address bound to the API key (0x…).
ARCUS_ADDRESS=

# Ed25519 API key: 64-hex public key + 64-hex private key.
# Create at https://app.arcus.xyz (mainnet) / POST https://api.arcus.xyz/v1/createApiKey
ARCUS_API_KEY=
ARCUS_API_SECRET=

# Keep true until quote logs look right on mainnet BBO.
DRY_RUN=false

# Strategy sizing (BTC-USD min notional is $5).
QUOTE_SIZE=0.001
LEVERAGE_X=40
QUOTE_OFFSET_BPS=0
REQUOTE_INTERVAL_MS=200
MIN_REQUOTE_TICKS=1
MAX_CLOSE_SLIPPAGE_BPS=5
# Skip quoting when BBO spread exceeds this.
MAX_SPREAD_BPS=20
MAX_OPEN_POSITION=0.001
ALLOW_EMERGENCY_MARKET_CLOSE=true

# Dead-man switch: if the process dies, Arcus cancel-alls when this expires.
# Venue has NO cancel-on-disconnect. Refresh continuously while running.
DMS_LEAD_SECONDS=15
DMS_REFRESH_SECONDS=5
